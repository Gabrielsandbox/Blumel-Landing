# Token gerado no SIM em Configurações > Webhooks > "Gerar Novo Token".
# Nunca commite o token nem o coloque no JavaScript da página.
SIM_TOKEN=

# Nome fixo que identifica esta landing na origem dos leads no SIM.
SIM_ORIGEM=landing-blumel

# Funil e etapa onde o lead entra no SIM. Padrão: funil 3778, etapa 21524.
# O id do funil aparece na URL do CRM ao abrir o quadro.
SIM_FUNIL_ID=3778
SIM_ETAPA_ID=21524

# Tags fixas, separadas por vírgula. As respostas do quiz são adicionadas automaticamente.
SIM_TAGS=landing

# Origens autorizadas a chamar /api/sim-lead de outro domínio (ex.: GitHub Pages).
ALLOWED_ORIGINS=https://gabrielsandbox.github.io

# Porta e host do servidor. O Railway define PORT sozinho.
PORT=4173
HOST=0.0.0.0
